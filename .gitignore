# ============================================================================
# Dolap Sale Prediction – .gitignore
# Senior-grade project ignore rules
# ============================================================================

# ────────────────────────────────────────────────────────────────────────────
# DATA – Cohort snapshots, labels, processed datasets (large / sensitive)
# ────────────────────────────────────────────────────────────────────────────
data/raw_snapshots/**
data/labels/**
data/processed/**
!data/labels/.gitkeep
!data/processed/.gitkeep
!data/interim/.gitkeep
!data/README.md

# ── Whitelist: cohort data for team access ──
!data/raw_snapshots/cohort_20250712/
data/raw_snapshots/cohort_20250712/**
!data/raw_snapshots/cohort_20250712/*.jsonl
!data/raw_snapshots/cohort_20250712/meta.yaml
!data/interim/cohort_20250712_cleaned.csv

!data/raw_snapshots/cohort_20260308/
data/raw_snapshots/cohort_20260308/**
!data/raw_snapshots/cohort_20260308/*.jsonl
!data/raw_snapshots/cohort_20260308/meta.yaml
!data/interim/cohort_20260308_cleaned.csv

!data/dolap_state.db

# ── Whitelist: canonical processed dataset used by classification notebook ──
!data/processed/model_ready_v3.csv
!data/processed/engineered_features.parquet
!data/processed/features_metadata.json

# ────────────────────────────────────────────────────────────────────────────
# ARTIFACTS – Trained models, generated figures, metric dumps
# ────────────────────────────────────────────────────────────────────────────
artifacts/models/*
artifacts/figures/*
artifacts/metrics/*
artifacts/experiments/*
!artifacts/models/.gitkeep
!artifacts/figures/.gitkeep
!artifacts/figures/*.png
!artifacts/figures/eda/
!artifacts/figures/eda/*.png
!artifacts/metrics/.gitkeep
!artifacts/metrics/*.json
!artifacts/metrics/*.md
!artifacts/experiments/.gitkeep
*.pkl
*.joblib
*.h5
*.hdf5
*.pt
*.pth
*.onnx
*.cbm
*.bin
*.model
# ── Whitelist: trained model artefacts shipped with repo for live demo ──
!models/
!models/*.joblib
!models/*.json

# ────────────────────────────────────────────────────────────────────────────
# REPORTS – Methodology addendum, presentation prep, article draft
#   (committed so the repo tells a complete story for CV/portfolio review)
# ────────────────────────────────────────────────────────────────────────────
reports/.DS_Store
!reports/
!reports/*.md
!reports/*.json
!reports/.gitkeep

# ────────────────────────────────────────────────────────────────────────────
# JUPYTER NOTEBOOKS – Strip output, keep source
# ────────────────────────────────────────────────────────────────────────────
notebooks/.ipynb_checkpoints/
*.ipynb_checkpoints/
# Uncomment below to ignore notebook outputs (use nbstripout pre-commit hook instead)
# notebooks/*.ipynb
# Static HTML exports (regenerated on demand via `jupyter nbconvert --to html --no-input`)
notebooks/*.html

# ────────────────────────────────────────────────────────────────────────────
# PYTHON
# ────────────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
eggs/
*.whl
pip-log.txt
pip-delete-this-directory.txt

# Virtual environments
.venv/
venv/
env/
ENV/
.conda/
*.conda
conda-meta/

# ────────────────────────────────────────────────────────────────────────────
# ENVIRONMENT & SECRETS
# ────────────────────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
secrets.yaml
secrets.json

# ────────────────────────────────────────────────────────────────────────────
# IDE / EDITOR
# ────────────────────────────────────────────────────────────────────────────
.vscode/
!.vscode/settings.json
!.vscode/launch.json
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ────────────────────────────────────────────────────────────────────────────
# AI ASSISTANT WORKSPACES — keep AI tooling configs out of the repo
# ────────────────────────────────────────────────────────────────────────────
CLAUDE.md
.claude/
.cursor/
.cursorignore
.cursorrules
.aider*
.continue/
.copilot/
.codeium/
.windsurf/
.zed/ai/
*.aichat
*.aichatlog
ai_context/

# ────────────────────────────────────────────────────────────────────────────
# OS FILES
# ────────────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# ────────────────────────────────────────────────────────────────────────────
# TESTING & COVERAGE
# ────────────────────────────────────────────────────────────────────────────
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.tox/
.nox/
coverage.xml
*.cover

# ────────────────────────────────────────────────────────────────────────────
# LOGS & DATABASES
# ────────────────────────────────────────────────────────────────────────────
*.log
*.sqlite3
*.db
!data/dolap_state.db

# ────────────────────────────────────────────────────────────────────────────
# SCRIPTS – Temporary debug/scratch files
# ────────────────────────────────────────────────────────────────────────────
scripts/debug_*
scripts/*.png
scripts/*.html

# ────────────────────────────────────────────────────────────────────────────
# MISC
# ────────────────────────────────────────────────────────────────────────────
*.csv
*.tsv
*.parquet
*.feather
*.arrow
*.json
*.jsonl
!configs/*.json
!configs/**/*.json
!package.json

# ── Whitelist: cohort data files for team access ──
!data/raw_snapshots/cohort_20250712/*.jsonl
!data/interim/cohort_20250712_cleaned.csv
!data/raw_snapshots/cohort_20260308/*.jsonl
!data/interim/cohort_20260308_cleaned.csv

# ── Whitelist: canonical processed dataset (must override *.csv / *.parquet / *.json blankets) ──
!data/processed/model_ready_v3.csv
!data/processed/engineered_features.parquet
!data/processed/features_metadata.json

# ── Whitelist: trained model artefacts (must override *.json blanket) ──
!models/*.json

# ── Whitelist: reports + artifact metric dumps (must override *.json blanket) ──
!reports/*.json
!artifacts/metrics/*.json

*.xml
!configs/*.xml
*.zip
*.tar.gz
*.tar.bz2
*.rar
*.7z
